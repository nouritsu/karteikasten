<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Auto Backup goes through CloudBackupAgent: the Google account only with
         Privatsphäre's Cloud-Sicherung on, a direct transfer to a new phone always (D62). -->
    <application
        android:allowBackup="true"
        android:backupAgent=".CloudBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="${appLabel}"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Regular exports and study reminders (Exports, Reminders), and the reboots,
             updates and clock changes that drop or shift their alarms. -->
        <receiver android:name=".AlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.nouritsu.karteikasten.RUN_EXPORT" />
                <action android:name="com.nouritsu.karteikasten.REMIND" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- navigator.vibrate on Weiß ich and Weiß ich nicht, and the steppers' tick -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Export writes Documents/Karteikasten/. Android 11 and newer need no permission
         for files the app creates; 10 needs legacy storage (above), 9 and older this. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- The study reminder (D63, Reminders) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Regular exports and reminders on time, where the user allows it (Exports, Reminders) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Their alarms are set again after a restart (AlarmReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
